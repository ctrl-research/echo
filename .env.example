# Copy to .env and adjust. docker-compose.yml reads this automatically.

# Host path to your music collection. Mounted read-only at /music.
ECHO_MUSIC_DIR=/srv/music

# Host port to publish.
ECHO_PORT=8080

# Change this before exposing the stack beyond localhost.
POSTGRES_PASSWORD=echo

# debug | info | warn | error
ECHO_LOG_LEVEL=info

# Public URL of this instance. OAuth redirect URIs derive from it, and session
# cookies are marked Secure when it is https. No trailing slash.
ECHO_BASE_URL=http://localhost:8080

# --- Sign-in -----------------------------------------------------------------
# Configure at least one provider, or nobody can sign in. The first person to
# sign in becomes the administrator.

# Google: create an OAuth client with redirect URI
# $ECHO_BASE_URL/auth/google/callback
#ECHO_GOOGLE_CLIENT_ID=
#ECHO_GOOGLE_CLIENT_SECRET=

# Generic OIDC (Authentik, Keycloak, Pocket ID, …). Redirect URI
# $ECHO_BASE_URL/auth/oidc/callback, scopes "openid email profile".
# Copy the issuer verbatim from the provider's discovery document.
#ECHO_OIDC_ISSUER_URL=
#ECHO_OIDC_CLIENT_ID=
#ECHO_OIDC_CLIENT_SECRET=
#ECHO_OIDC_NAME=Authentik

# Who may create an account once the first user exists. Comma-separated exact
# addresses, case-insensitive. This gates sign-up, not sign-in.
#ECHO_ALLOWED_EMAILS=someone@example.com,someone-else@example.com

# Email/password accounts. Off by default; intended for bringing an instance up
# before an IdP exists, or as a break-glass administrator.
#ECHO_LOCAL_AUTH=true
#ECHO_ADMIN_EMAIL=admin@example.com
#ECHO_ADMIN_PASSWORD=change-me-before-first-start

# Session lifetime.
ECHO_SESSION_TTL=720h

# YouTube cache. The TTL slides on each play; the max lifetime caps how far it
# can reach from the original download.
#ECHO_YT_MAX_LIFETIME=336h
# Only needed if your address gets challenged by YouTube.
#ECHO_YT_COOKIES_FILE=/config/cookies.txt
